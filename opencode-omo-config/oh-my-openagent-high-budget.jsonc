// high-budget config
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "disabled_providers": ["anthropic", "google"],
  "model_fallback": true,
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [400, 401, 403, 404, 429, 500, 502, 503, 504],
    "max_fallback_attempts": 3,
    "cooldown_seconds": 30,
    "timeout_seconds": 20,
    "notify_on_fallback": true
  },
  "model_capabilities": {
    "enabled": true,
    "auto_refresh_on_start": true,
    "refresh_timeout_ms": 5000
  },
  "agents": {
    "sisyphus": {
      "model": "opencode-go/kimi-k2.7",
      "ultrawork": {
        "model": "opencode-go/kimi-k2.7"
      },
      "fallback_models": [
        {
          "model": "openai/gpt-5.5",
          "variant": "medium"
        },
        "opencode-go/glm-5.2"
      ]
    },
    "hephaestus": {
      "model": "openai/gpt-5.5",
      "variant": "medium"
    },
    "oracle": {
      "model": "openai/gpt-5.5",
      "variant": "high",
      "fallback_models": ["opencode-go/glm-5.2"]
    },
    "explore": {
      "model": "openai/gpt-5.4-mini",
      "fallback_models": [
        "opencode-go/qwen3.6-plus",
        "opencode-go/minimax-m3",
        "openai/gpt-5.4-nano",
        "venice/grok-41-fast"
      ]
    },
    "multimodal-looker": {
      "model": "openai/gpt-5.5",
      "variant": "medium",
      "fallback_models": [
        "opencode-go/kimi-k2.7",
        "openai/gpt-5-nano",
        "venice/grok-41-fast"
      ]
    },
    "prometheus": {
      "model": "openai/gpt-5.5",
      "variant": "high",
      "fallback_models": ["opencode-go/glm-5.2", "opencode-go/kimi-k2.7"]
    },
    "metis": {
      "model": "openai/gpt-5.5",
      "variant": "high",
      "fallback_models": ["opencode-go/glm-5.2", "opencode-go/kimi-k2.7"]
    },
    "momus": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "fallback_models": ["opencode-go/glm-5.2"]
    },
    "atlas": {
      "model": "opencode-go/kimi-k2.7",
      "fallback_models": [
        {
          "model": "openai/gpt-5.5",
          "variant": "medium"
        },
        "opencode-go/minimax-m3"
      ]
    },
    "sisyphus-junior": {
      "model": "opencode-go/kimi-k2.7",
      "fallback_models": [
        "opencode-go/minimax-m3",
        {
          "model": "openai/gpt-5.5",
          "variant": "medium"
        }
      ]
    },
    "librarian": {
      "model": "openai/gpt-5.4-mini",
      "fallback_models": [
        "opencode-go/qwen3.6-plus",
        "opencode-go/minimax-m3",
        "openai/gpt-5.4-nano",
        "venice/grok-41-fast"
      ]
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "opencode-go/qwen3.6-plus",
      "fallback_models": ["venice/grok-41-fast"]
    },
    "ultrabrain": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "fallback_models": ["opencode-go/glm-5.2"]
    },
    "deep": {
      "model": "openai/gpt-5.5",
      "variant": "medium",
      "fallback_models": [
        "openai/gpt-5.3-codex",
        "opencode-go/kimi-k2.7",
        "opencode-go/glm-5.2"
      ]
    },
    "quick": {
      "model": "openai/gpt-5.4-mini",
      "fallback_models": ["opencode-go/minimax-m3", "openai/gpt-5.4-nano"]
    },
    "unspecified-low": {
      "model": "opencode-go/kimi-k2.7",
      "fallback_models": ["opencode-go/minimax-m3"]
    },
    "unspecified-high": {
      "model": "openai/gpt-5.5",
      "variant": "high",
      "fallback_models": ["opencode-go/kimi-k2.7", "opencode-go/glm-5.2"]
    },
    "writing": {
      "model": "opencode-go/kimi-k2.7",
      "fallback_models": ["openai/gpt-5.4-mini", "opencode-go/minimax-m3"]
    },
    "artistry": {
      "model": "opencode-go/qwen3.6-plus",
      "fallback_models": [
        {
          "model": "openai/gpt-5.5",
          "variant": "medium"
        }
      ]
    }
  },
  "background_task": {
    "providerConcurrency": {
      "openai": 2,
      "opencode-go": 8,
      "venice": 1
    },
    "modelConcurrency": {
      "openai/gpt-5.5": 2,
      "openai/gpt-5.5:xhigh": 1,
      "venice/grok-41-fast": 1
    }
  },
  "git_master": {
    "commit_footer": true,
    "include_co_authored_by": false,
    "git_env_prefix": "GIT_MASTER=1"
  }
}
