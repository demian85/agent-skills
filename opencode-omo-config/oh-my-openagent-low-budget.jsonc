// low-budget config: OpenCode Go first; GPT-5.5 medium is retained only for Hephaestus, which requires GPT.
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "disabled_providers": ["anthropic", "google", "venice"],
  "model_fallback": true,
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [400, 401, 403, 404, 429, 500, 502, 503, 504],
    "max_fallback_attempts": 3,
    "cooldown_seconds": 30,
    "timeout_seconds": 20,
    "notify_on_fallback": true
  },
  "model_capabilities": {
    "enabled": true,
    "auto_refresh_on_start": true,
    "refresh_timeout_ms": 5000
  },
  "agents": {
    "sisyphus": {
      "model": "opencode-go/kimi-k2.7-code",
      "ultrawork": {
        "model": "opencode-go/kimi-k2.7-code"
      },
      "fallback_models": ["opencode-go/kimi-k2.6", "opencode-go/glm-5.2"]
    },
    "hephaestus": {
      "model": "openai/gpt-5.5",
      "variant": "medium"
    },
    "oracle": {
      "model": "opencode-go/glm-5.2",
      "fallback_models": ["opencode-go/kimi-k2.6"]
    },
    "explore": {
      "model": "opencode-go/qwen3.5-plus",
      "fallback_models": ["opencode-go/minimax-m3", "openai/gpt-5.4-nano"]
    },
    "multimodal-looker": {
      "model": "opencode-go/kimi-k2.6",
      "fallback_models": ["openai/gpt-5-nano"]
    },
    "prometheus": {
      "model": "opencode-go/glm-5.2",
      "fallback_models": ["opencode-go/kimi-k2.6"]
    },
    "metis": {
      "model": "opencode-go/glm-5.2",
      "fallback_models": ["opencode-go/kimi-k2.6"]
    },
    "momus": {
      "model": "opencode-go/glm-5.2",
      "fallback_models": ["opencode-go/kimi-k2.6"]
    },
    "atlas": {
      "model": "opencode-go/kimi-k2.7-code",
      "fallback_models": ["opencode-go/minimax-m3", "opencode-go/kimi-k2.6"]
    },
    "sisyphus-junior": {
      "model": "opencode-go/kimi-k2.7-code",
      "fallback_models": ["opencode-go/minimax-m3", "opencode-go/kimi-k2.6"]
    },
    "librarian": {
      "model": "opencode-go/qwen3.5-plus",
      "fallback_models": ["opencode-go/minimax-m3", "openai/gpt-5.4-nano"]
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "opencode-go/qwen3.6-plus",
      "fallback_models": []
    },
    "ultrabrain": {
      "model": "opencode-go/glm-5.2",
      "fallback_models": ["opencode-go/kimi-k2.6"]
    },
    "deep": {
      "model": "opencode-go/glm-5.2",
      "fallback_models": ["opencode-go/kimi-k2.6"]
    },
    "quick": {
      "model": "opencode-go/minimax-m3",
      "fallback_models": ["openai/gpt-5.4-nano"]
    },
    "unspecified-low": {
      "model": "opencode-go/kimi-k2.7-code",
      "fallback_models": ["opencode-go/minimax-m3"]
    },
    "unspecified-high": {
      "model": "opencode-go/kimi-k2.7-code",
      "fallback_models": ["opencode-go/glm-5.2", "opencode-go/kimi-k2.6"]
    },
    "writing": {
      "model": "opencode-go/kimi-k2.7-code",
      "fallback_models": ["opencode-go/kimi-k2.6", "opencode-go/minimax-m3"]
    },
    "artistry": {
      "model": "opencode-go/qwen3.6-plus",
      "fallback_models": []
    }
  },
  "background_task": {
    "providerConcurrency": {
      "openai": 1,
      "opencode-go": 8
    },
    "modelConcurrency": {
      "openai/gpt-5.5": 1
    }
  },
  "git_master": {
    "commit_footer": true,
    "include_co_authored_by": false,
    "git_env_prefix": "GIT_MASTER=1"
  }
}
