// Mid-budget OMO profile: current routing preserved, with Kimi K3 preferred where compatible.
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "profiles": {},
  "[opencode]": {
    "agents": {
      "sisyphus": {
        "model": "opencode-go/kimi-k3",
        "fallback_models": [
          { "model": "openai/gpt-5.5", "variant": "medium" },
          "opencode-go/glm-5.2"
        ],
        "ultrawork": { "model": "opencode-go/kimi-k3" }
      },
      "hephaestus": {
        "model": "openai/gpt-5.6-sol",
        "variant": "medium",
        "fallback_models": [{ "model": "openai/gpt-5.5", "variant": "medium" }]
      },
      "oracle": {
        "model": "openai/gpt-5.6-terra",
        "variant": "high",
        "fallback_models": ["opencode-go/glm-5.2"]
      },
      "librarian": {
        "model": "openai/gpt-5.4-mini-fast",
        "fallback_models": [
          "opencode-go/qwen3.7-plus",
          "opencode-go/minimax-m3",
          "openai/gpt-5.4-mini",
          "venice/grok-4-5"
        ]
      },
      "explore": {
        "model": "openai/gpt-5.4-mini-fast",
        "fallback_models": [
          "opencode-go/qwen3.7-plus",
          "opencode-go/minimax-m3",
          "openai/gpt-5.4-mini",
          "venice/grok-4-5"
        ]
      },
      "multimodal-looker": {
        "model": "openai/gpt-5.6-terra",
        "variant": "medium",
        "fallback_models": ["opencode-go/kimi-k3", "openai/gpt-5.4-mini", "venice/grok-4-5"]
      },
      "prometheus": {
        "model": "openai/gpt-5.6-terra",
        "variant": "high",
        "fallback_models": ["opencode-go/glm-5.2", "opencode-go/kimi-k3"]
      },
      "metis": {
        "model": "openai/gpt-5.6-terra",
        "variant": "high",
        "fallback_models": ["opencode-go/glm-5.2", "opencode-go/kimi-k3"]
      },
      "momus": {
        "model": "openai/gpt-5.6-sol",
        "variant": "xhigh",
        "fallback_models": [
          { "model": "openai/gpt-5.5", "variant": "xhigh" },
          "opencode-go/glm-5.2"
        ]
      },
      "atlas": {
        "model": "opencode-go/kimi-k3",
        "fallback_models": [
          { "model": "openai/gpt-5.5", "variant": "medium" },
          "opencode-go/minimax-m3"
        ]
      },
      "sisyphus-junior": {
        "model": "opencode-go/kimi-k3",
        "fallback_models": [
          "opencode-go/minimax-m3",
          { "model": "openai/gpt-5.5", "variant": "medium" }
        ]
      }
    },
    "categories": {
      "visual-engineering": {
        "model": "opencode-go/kimi-k3",
        "variant": "max",
        "fallback_models": [
          { "model": "opencode-go/glm-5.2", "variant": "max" },
          "venice/grok-4-5"
        ]
      },
      "ultrabrain": {
        "model": "openai/gpt-5.6-sol",
        "variant": "xhigh",
        "fallback_models": [
          { "model": "openai/gpt-5.5", "variant": "xhigh" },
          "opencode-go/glm-5.2"
        ]
      },
      "deep": {
        "model": "openai/gpt-5.6-terra",
        "variant": "xhigh",
        "fallback_models": [
          { "model": "openai/gpt-5.6-sol", "variant": "high" },
          { "model": "openai/gpt-5.5", "variant": "medium" },
          "opencode-go/kimi-k3",
          "opencode-go/glm-5.2"
        ]
      },
      "artistry": {
        "model": "opencode-go/kimi-k3",
        "variant": "max",
        "fallback_models": [{ "model": "openai/gpt-5.5", "variant": "medium" }]
      },
      "quick": {
        "model": "openai/gpt-5.4-mini",
        "fallback_models": ["opencode-go/minimax-m3"]
      },
      "unspecified-low": {
        "model": "openai/gpt-5.6-luna",
        "variant": "xhigh",
        "fallback_models": [
          "opencode-go/kimi-k3",
          { "model": "openai/gpt-5.5", "variant": "medium" },
          "opencode-go/minimax-m3"
        ]
      },
      "unspecified-high": {
        "model": "openai/gpt-5.6-terra",
        "variant": "high",
        "fallback_models": ["opencode-go/kimi-k3", "opencode-go/glm-5.2"]
      },
      "writing": {
        "model": "opencode-go/kimi-k3",
        "variant": "low",
        "fallback_models": ["openai/gpt-5.4-mini", "opencode-go/minimax-m3"]
      }
    },
    "disabled_providers": ["anthropic", "google"],
    "model_fallback": true,
    "runtime_fallback": {
      "enabled": true,
      "retry_on_errors": [400, 401, 403, 404, 429, 500, 502, 503, 504],
      "max_fallback_attempts": 3,
      "cooldown_seconds": 30,
      "timeout_seconds": 20,
      "notify_on_fallback": true
    },
    "model_capabilities": {
      "enabled": true,
      "auto_refresh_on_start": true,
      "refresh_timeout_ms": 5000
    },
    "background_task": {
      "providerConcurrency": {
        "openai": 3,
        "opencode-go": 8,
        "venice": 1
      },
      "modelConcurrency": {
        "openai/gpt-5.5": 2,
        "openai/gpt-5.6-sol": 2,
        "openai/gpt-5.6-sol:xhigh": 1,
        "openai/gpt-5.6-terra": 2,
        "openai/gpt-5.6-terra:xhigh": 1,
        "openai/gpt-5.6-luna:xhigh": 1,
        "opencode-go/kimi-k3": 4,
        "venice/grok-4-5": 1
      }
    },
    "git_master": {
      "commit_footer": true,
      "include_co_authored_by": false,
      "git_env_prefix": "GIT_MASTER=1"
    }
  },
  // Codex Light keeps model selection in ~/.codex/config.toml and its agent TOMLs.
  "[codex]": {
    "codegraph": {}
  }
}
