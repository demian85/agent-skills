// OMO configuration
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "profiles": {},
  "[opencode]": {
    "agents": {
      "sisyphus": {
        "model": "opencode-go/kimi-k2.7-code",
        "fallback_models": [
          {
            "model": "openai/gpt-5.5",
            "variant": "medium"
          },
          "opencode-go/glm-5.2"
        ],
        "ultrawork": {
          "model": "opencode-go/kimi-k2.7-code"
        }
      },
      "hephaestus": {
        "model": "openai/gpt-5.6-sol",
        "variant": "medium",
        "fallback_models": [
          {
            "model": "openai/gpt-5.5",
            "variant": "medium"
          }
        ]
      },
      "oracle": {
        "model": "openai/gpt-5.6-terra",
        "variant": "high",
        "fallback_models": ["opencode-go/glm-5.2"]
      },
      "librarian": {
        "model": "openai/gpt-5.4-mini-fast",
        "fallback_models": [
          "opencode-go/qwen3.5-plus",
          "opencode-go/minimax-m3",
          "openai/gpt-5.4-nano",
          "venice/grok-41-fast"
        ]
      },
      "explore": {
        "model": "openai/gpt-5.4-mini-fast",
        "fallback_models": [
          "opencode-go/qwen3.5-plus",
          "opencode-go/minimax-m3",
          "openai/gpt-5.4-nano",
          "venice/grok-41-fast"
        ]
      },
      "multimodal-looker": {
        "model": "openai/gpt-5.6-terra",
        "variant": "medium",
        "fallback_models": [
          "opencode-go/kimi-k2.6",
          "openai/gpt-5-nano",
          "venice/grok-41-fast"
        ]
      },
      "prometheus": {
        "model": "openai/gpt-5.6-terra",
        "variant": "high",
        "fallback_models": ["opencode-go/glm-5.2", "opencode-go/kimi-k2.7-code"]
      },
      "metis": {
        "model": "openai/gpt-5.6-terra",
        "variant": "high",
        "fallback_models": ["opencode-go/glm-5.2", "opencode-go/kimi-k2.7-code"]
      },
      "momus": {
        "model": "openai/gpt-5.6-sol",
        "variant": "xhigh",
        "fallback_models": [
          {
            "model": "openai/gpt-5.5",
            "variant": "xhigh"
          },
          "opencode-go/glm-5.2"
        ]
      },
      "atlas": {
        "model": "opencode-go/kimi-k2.7-code",
        "fallback_models": [
          {
            "model": "openai/gpt-5.5",
            "variant": "medium"
          },
          "opencode-go/kimi-k2.6",
          "opencode-go/minimax-m3"
        ]
      },
      "sisyphus-junior": {
        "model": "opencode-go/kimi-k2.7-code",
        "fallback_models": [
          "opencode-go/minimax-m3",
          "opencode-go/kimi-k2.6",
          {
            "model": "openai/gpt-5.5",
            "variant": "medium"
          }
        ]
      }
    },
    "categories": {
      "visual-engineering": {
        "model": "opencode-go/qwen3.6-plus",
        "variant": "high",
        "fallback_models": ["venice/grok-41-fast"]
      },
      "ultrabrain": {
        "model": "openai/gpt-5.6-sol",
        "variant": "xhigh",
        "fallback_models": [
          {
            "model": "openai/gpt-5.5",
            "variant": "xhigh"
          },
          "opencode-go/glm-5.2"
        ]
      },
      "deep": {
        "model": "openai/gpt-5.6-terra",
        "variant": "xhigh",
        "fallback_models": [
          {
            "model": "openai/gpt-5.6-sol",
            "variant": "high"
          },
          {
            "model": "openai/gpt-5.5",
            "variant": "medium"
          },
          "opencode-go/kimi-k2.6",
          "opencode-go/glm-5.2"
        ]
      },
      "artistry": {
        "model": "opencode-go/qwen3.6-plus",
        "variant": "high",
        "fallback_models": [
          {
            "model": "openai/gpt-5.5",
            "variant": "medium"
          }
        ]
      },
      "quick": {
        "model": "openai/gpt-5.4-mini",
        "fallback_models": ["opencode-go/minimax-m3", "openai/gpt-5.4-nano"]
      },
      "unspecified-low": {
        "model": "openai/gpt-5.6-luna",
        "variant": "xhigh",
        "fallback_models": [
          "opencode-go/kimi-k2.6",
          {
            "model": "openai/gpt-5.5",
            "variant": "medium"
          },
          "opencode-go/minimax-m3"
        ]
      },
      "unspecified-high": {
        "model": "openai/gpt-5.6-terra",
        "variant": "high",
        "fallback_models": ["opencode-go/kimi-k2.7-code", "opencode-go/glm-5.2"]
      },
      "writing": {
        "model": "opencode-go/kimi-k2.7-code",
        "fallback_models": ["openai/gpt-5.4-mini", "opencode-go/minimax-m3"]
      }
    },
    "disabled_providers": ["anthropic", "google"],
    "model_fallback": true,
    "runtime_fallback": {
      "enabled": true,
      "retry_on_errors": [400, 401, 403, 404, 429, 500, 502, 503, 504],
      "max_fallback_attempts": 3,
      "cooldown_seconds": 30,
      "timeout_seconds": 20,
      "notify_on_fallback": true
    },
    "model_capabilities": {
      "enabled": true,
      "auto_refresh_on_start": true,
      "refresh_timeout_ms": 5000
    },
    "background_task": {
      "providerConcurrency": {
        "openai": 3,
        "opencode-go": 8,
        "venice": 1
      },
      "modelConcurrency": {
        "openai/gpt-5.5": 2,
        "openai/gpt-5.6-sol": 2,
        "openai/gpt-5.6-sol:xhigh": 1,
        "openai/gpt-5.6-terra": 2,
        "openai/gpt-5.6-terra:xhigh": 1,
        "openai/gpt-5.6-luna:xhigh": 1,
        "venice/grok-41-fast": 1
      }
    },
    "git_master": {
      "commit_footer": true,
      "include_co_authored_by": false,
      "git_env_prefix": "GIT_MASTER=1"
    },
    "codegraph": {}
  },
  "codegraph": {},
  "[codex]": {
    "codegraph": {}
  },
  "_migrations": [
    "2026-07-codex-config-jsonc"
  ]
}
