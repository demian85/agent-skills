// Low-budget OMO profile: OpenCode Go first, OpenAI only for Hephaestus.
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "profiles": {},
  "[opencode]": {
    "agents": {
      "sisyphus": {
        "model": "opencode-go/kimi-k2.7-code",
        "fallback_models": ["opencode-go/glm-5.2"],
        "ultrawork": { "model": "opencode-go/kimi-k2.7-code" }
      },
      // Hephaestus is GPT-native. This is the only normal OpenAI assignment.
      "hephaestus": {
        "model": "openai/gpt-5.6-sol",
        "variant": "medium"
      },
      "oracle": {
        "model": "opencode-go/glm-5.2",
        "fallback_models": ["opencode-go/kimi-k3"]
      },
      "librarian": {
        "model": "opencode-go/qwen3.7-plus",
        "fallback_models": ["opencode-go/minimax-m3", "opencode-go/minimax-m2.7"]
      },
      "explore": {
        "model": "opencode-go/qwen3.7-plus",
        "fallback_models": ["opencode-go/minimax-m3", "opencode-go/minimax-m2.7"]
      },
      "multimodal-looker": {
        "model": "opencode-go/kimi-k3",
        "fallback_models": ["opencode-go/glm-5.2"]
      },
      "prometheus": {
        "model": "opencode-go/kimi-k3",
        "variant": "max",
        "fallback_models": ["opencode-go/kimi-k2.7-code", "opencode-go/glm-5.2"]
      },
      "metis": {
        "model": "opencode-go/kimi-k3",
        "fallback_models": ["opencode-go/glm-5.2"]
      },
      "momus": {
        "model": "opencode-go/glm-5.2",
        "fallback_models": ["opencode-go/kimi-k3"]
      },
      "atlas": {
        "model": "opencode-go/kimi-k3",
        "fallback_models": ["opencode-go/minimax-m3", "opencode-go/minimax-m2.7"]
      },
      "sisyphus-junior": {
        "model": "opencode-go/kimi-k3",
        "fallback_models": ["opencode-go/minimax-m3", "opencode-go/minimax-m2.7"]
      }
    },
    "categories": {
      "visual-engineering": {
        "model": "opencode-go/kimi-k3",
        "variant": "max",
        "fallback_models": [{ "model": "opencode-go/glm-5.2", "variant": "max" }]
      },
      "ultrabrain": {
        "model": "opencode-go/glm-5.2",
        "fallback_models": ["opencode-go/kimi-k3"]
      },
      "deep": {
        "model": "opencode-go/kimi-k3",
        "fallback_models": ["opencode-go/glm-5.2"]
      },
      "artistry": {
        "model": "opencode-go/kimi-k3",
        "variant": "max",
        "fallback_models": ["opencode-go/glm-5.2"]
      },
      "quick": {
        "model": "opencode-go/minimax-m2.7",
        "fallback_models": ["opencode-go/minimax-m3"]
      },
      "unspecified-low": {
        "model": "opencode-go/kimi-k2.7-code",
        "fallback_models": ["opencode-go/minimax-m3", "opencode-go/minimax-m2.7"]
      },
      "unspecified-high": {
        "model": "opencode-go/kimi-k3",
        "variant": "max",
        "fallback_models": ["opencode-go/glm-5.2"]
      },
      "writing": {
        "model": "opencode-go/kimi-k3",
        "fallback_models": ["opencode-go/minimax-m3"]
      }
    },
    "disabled_providers": ["anthropic", "google", "venice"],
    "model_fallback": true,
    "runtime_fallback": {
      "enabled": true,
      "retry_on_errors": [400, 401, 403, 404, 429, 500, 502, 503, 504],
      "max_fallback_attempts": 3,
      "cooldown_seconds": 30,
      "timeout_seconds": 20,
      "notify_on_fallback": true
    },
    "model_capabilities": {
      "enabled": true,
      "auto_refresh_on_start": true,
      "refresh_timeout_ms": 5000
    },
    "background_task": {
      "providerConcurrency": {
        "openai": 1,
        "opencode-go": 8
      },
      "modelConcurrency": {
        "openai/gpt-5.6-sol": 1,
        "opencode-go/kimi-k3": 5,
        "opencode-go/glm-5.2": 3
      }
    },
    "git_master": {
      "commit_footer": true,
      "include_co_authored_by": false,
      "git_env_prefix": "GIT_MASTER=1"
    }
  },
  // Codex Light keeps model selection in ~/.codex/config.toml and its agent TOMLs.
  "[codex]": {
    "codegraph": {}
  }
}
